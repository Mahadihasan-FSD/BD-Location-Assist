# ==============================================================================
# BD LOCATION ASSIST - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE VARIABLES (Vite Frontend - Safe for Browser)
# ------------------------------------------------------------------------------
# VITE_SUPABASE_URL: URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
# Found in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: Client-side public anon key for Supabase Auth and database operations
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon (public)
VITE_SUPABASE_ANON_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Browser API key for Google Maps JavaScript rendering
# Setup: Enable "Maps JavaScript API" in Google Cloud Console and restrict key to your domain
VITE_GOOGLE_MAPS_API_KEY=""

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE VARIABLES (Express Backend - Secret, NEVER exposed to client)
# ------------------------------------------------------------------------------
# SUPABASE_URL: URL of your Supabase project (same as VITE_SUPABASE_URL)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Backend-only secret service role key for administrative tasks and bypass of RLS
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=""

# APP_URL: Base URL where this app is hosted (e.g., https://your-app.run.app or http://localhost:3000)
# Used for constructing full invitation links
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key for signing internal tokens and session hashes
SESSION_SECRET="bd-location-assist-secure-secret-key-2026"

# GEMINI_API_KEY: Server-side Gemini AI key (managed automatically by AI Studio)
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 3. GOOGLE OAUTH CONFIGURATION NOTE:
# ------------------------------------------------------------------------------
# DO NOT put GOOGLE_CLIENT_ID or GOOGLE_CLIENT_SECRET in this .env file!
# Because Google Login is handled natively by Supabase Auth:
# 1. Create OAuth credentials in Google Cloud Console (APIs & Services > Credentials).
# 2. Add this Authorized Redirect URI in Google Cloud Console:
#    https://<YOUR-SUPABASE-PROJECT-REF>.supabase.co/auth/v1/callback
# 3. Enter your Google Client ID & Secret in:
#    Supabase Dashboard > Authentication > Providers > Google > Enable Google
# ==============================================================================
