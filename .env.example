# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for generating full invitation links.
APP_URL="http://localhost:3000"

# GOOGLE MAPS JAVASCRIPT API (Browser Key)
# Required for interactive Google Maps rendering with Bangladesh locality and street details.
# Setup instructions:
# 1. Open Google Cloud Console (https://console.cloud.google.com).
# 2. Create or select an existing GCP project.
# 3. Enable the "Maps JavaScript API".
# 4. Configure billing if required.
# 5. Create an API key under Credentials.
# 6. Restrict key to HTTP referrers (your app domain) and API to "Maps JavaScript API".
# 7. Add key here as VITE_GOOGLE_MAPS_API_KEY and restart the dev server.
VITE_GOOGLE_MAPS_API_KEY=""

# SUPABASE_URL: URL of your Supabase PostgreSQL project (e.g. https://your-project.supabase.co)
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Client-side anonymous public key for Supabase
SUPABASE_ANON_KEY=""

# SUPABASE_SERVICE_ROLE_KEY: Backend-only service role key for admin database operations
SUPABASE_SERVICE_ROLE_KEY=""

# Google OAuth Credentials (for Google Sign-In)
# Callback URL to register: https://<your-app-url>/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SESSION_SECRET: Secret used for signing session auth tokens
SESSION_SECRET="bd-location-assist-secure-secret-key-2026"
